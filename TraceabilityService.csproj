<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="TraceabilityService.Tests\**" />
    <Content Remove="TraceabilityService.Tests\**" />
    <EmbeddedResource Remove="TraceabilityService.Tests\**" />
    <None Remove="TraceabilityService.Tests\**" />
  </ItemGroup>
  
  <ItemGroup>
    <Protobuf Include="..\shared_protos\traceability.proto" GrpcServices="Server" />
    <Protobuf Include="..\shared_protos\orchestrator.proto" GrpcServices="Client,Server" />
    <Protobuf Include="..\shared_protos\models.proto" GrpcServices="Client,Server" />
    <Protobuf Include="..\shared_protos\processor.proto" GrpcServices="Client,Server" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.64.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.0" />
    <PackageReference Include="NATS.Client.Core" Version="2.8.2" />
    <PackageReference Include="NATS.Client.JetStream" Version="2.8.2" />
  </ItemGroup>

</Project>
